# --- Meta / Facebook ---
META_ACCESS_TOKEN=your_meta_access_token_here
FB_PAGE_ID=your_facebook_page_id_here

# --- Instagram ---
IG_ACCOUNT_ID=your_instagram_business_account_id_here

# --- TikTok ---
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id_here

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORG_ID=your_linkedin_organization_id_here

# --- YouTube ---
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# --- Email / SMTP ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_smtp_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# --- Google Sheets ---
# Paste the raw JSON content of your service-account key, or its base64-encoded form.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
SHEET_ID=your_google_sheet_id_here

# --- Database (optional) ---
# Leave unset to use the default SQLite DB at data/metrics.db
# Set to a PostgreSQL DSN to use PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/social_reports
DATABASE_URL=
